#!/bin/bash -eu
#
# archive-filter-time-window.sample — Example time-window archive filter
#
# The archiveloop calls /root/bin/archive-filter (if it exists and is
# executable) with the path to the file list before archiving.  This sample
# demonstrates filtering SavedClips by time-of-day — e.g. only archive
# clips recorded during daytime hours.
#
# This is useful for users who only want driving footage (daytime) and
# don't want to archive nighttime Sentry events that fill up storage.
#
# To use: copy this file to /root/bin/archive-filter, make it executable,
# and customise the time window.
#
# Input:  $1 = path to a text file listing clip files (one per line,
#         relative to the overlay mount point)
# Output: the same file, modified in-place
#
# Config:
#   FILTER_START_HOUR   — start hour (0-23, default 6 = 6am)
#   FILTER_END_HOUR     — end hour (0-23, default 20 = 8pm)
#   FILTER_APPLY_TO     — which clips to filter: "SavedClips", "SentryClips",
#                         "all" (default: "SavedClips")
#
# Clip filenames contain timestamps in the format:
#   SavedClips/2024-01-15_14-30-00/2024-01-15_14-30-00-front.mp4
#   RecentClips/2024-01-15_14-30-00-front.mp4
#
# ---------------------------------------------------------------------------

FILE_LIST="$1"

START_HOUR="${FILTER_START_HOUR:-6}"
END_HOUR="${FILTER_END_HOUR:-20}"
APPLY_TO="${FILTER_APPLY_TO:-SavedClips}"

# Only filter if the file list is non-empty
if [ ! -s "$FILE_LIST" ]
then
  exit 0
fi

cp "$FILE_LIST" "${FILE_LIST}.bak"

# Extract the hour from clip filenames and filter by time window.
# Filenames contain _HH-MM-SS which we use to determine recording time.
while IFS= read -r line
do
  # Determine if this line should be checked
  case "$line" in
    SavedClips/*)
      [ "$APPLY_TO" = "SavedClips" ] || [ "$APPLY_TO" = "all" ] || { echo "$line"; continue; }
      ;;
    SentryClips/*)
      [ "$APPLY_TO" = "SentryClips" ] || [ "$APPLY_TO" = "all" ] || { echo "$line"; continue; }
      ;;
    *)
      echo "$line"
      continue
      ;;
  esac

  # Extract hour from the folder name (format: YYYY-MM-DD_HH-MM-SS)
  # For SavedClips: folder name is the second path component
  # For RecentClips: hour is in the filename itself
  timestamp=""
  case "$line" in
    */*)
      folder=$(echo "$line" | cut -d'/' -f2)
      timestamp="$folder"
      ;;
    *)
      timestamp=$(basename "$line")
      ;;
  esac

  # Extract hour from timestamp (format: YYYY-MM-DD_HH-MM-SS)
  hour=$(echo "$timestamp" | sed -n 's/.*_\([0-9]\{2\}\)-.*/\1/p')

  if [ -n "$hour" ]
  then
    if [ "$START_HOUR" -le "$END_HOUR" ] 2>/dev/null
    then
      # Normal range, e.g. 6-20
      if [ "$hour" -ge "$START_HOUR" ] && [ "$hour" -lt "$END_HOUR" ] 2>/dev/null
      then
        echo "$line"
      fi
    else
      # Overnight range, e.g. 20-6 (nighttime only)
      if [ "$hour" -ge "$START_HOUR" ] || [ "$hour" -lt "$END_HOUR" ] 2>/dev/null
      then
        echo "$line"
      fi
    fi
  else
    # Can't parse hour — keep the file to be safe
    echo "$line"
  fi
done < "${FILE_LIST}.bak" > "$FILE_LIST"

rm -f "${FILE_LIST}.bak"

filtered_count=$(wc -l < "$FILE_LIST")
echo "$(date): archive-filter: $filtered_count clips after time-window filter ($START_HOUR:00-$END_HOUR:00, apply_to=$APPLY_TO)" >&2