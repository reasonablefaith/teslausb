#!/bin/bash -eu
#
# archive-filter.sample — Example archive filter script
#
# The archiveloop calls /root/bin/archive-filter (if it exists and is
# executable) with the path to the file list ($sentrylist) before
# archiving.  The filter script can modify the list in-place to:
#
#   * Keep only certain cameras (e.g. front-only for a driving channel)
#   * Drop clips that are too short (already handled by archiveloop, but
#     custom thresholds can be applied here)
#   * Exclude Sentry events outside a geofence
#   * Implement selective retention policies
#
# To use: copy this file to /root/bin/archive-filter, make it executable,
# and customise the filtering logic.
#
# Input:  $1 = path to a text file listing clip files (one per line,
#         relative to the overlay mount point)
# Output: the same file, modified in-place
#
# Available environment variables (from envsetup.sh):
#   ARCHIVE_RECENTCLIPS — "true" if RecentClips are being archived
#   CAM_MOUNT           — /mnt/cam (the live cam mount)
#   MUSIC_MOUNT         — /mnt/music
#   RSYNC_SERVER        — archive server hostname/IP
#   RSYNC_PATH          — archive path on server
#
# Example: keep only front-camera clips (works for SavedClips + RecentClips)
# ---------------------------------------------------------------------------
# Front-only filter, v3: drops all non-front clips and deduplicates by folder,
# preferring concat symlinks (e.g. 2026-06-03_12-00-00/2026-06-03_12-00-00-front.mp4)
# over their constituent parts. Works for both SavedClips and RecentClips
# because the v2 bug (hardcoded SavedClips/ prefix) is fixed.
# ---------------------------------------------------------------------------

filelist=$1
tmpfile=${filelist}.filtered.$$

# Step 1: Keep only front clips
grep '\-front\.mp4$' "$filelist" > "$tmpfile" || true

finalfile=${filelist}.final.$$
> "$finalfile"

# Step 2: Deduplicate by folder, prefer concat symlinks
folders=$(cut -d'/' -f1-2 "$tmpfile" | sort -u)
for folder_line in $folders; do
    folder_basename=$(basename "$folder_line")
    concat_match=$(grep "^$folder_line/$folder_basename-front\.mp4$" "$tmpfile" || true)
    if [ -n "$concat_match" ]; then
        echo "$concat_match" >> "$finalfile"
    else
        grep "^$folder_line/.*-front\.mp4$" "$tmpfile" >> "$finalfile" || true
    fi
done

removed=$(grep -c -v '\-front\.mp4$' "$filelist" 2>/dev/null || echo 0)
kept=$(wc -l < "$finalfile" 2>/dev/null || echo 0)

if [ "$removed" -gt 0 ] || [ "$kept" -gt 0 ]; then
    logger -t teslausb "archive-filter v3: kept $kept front clips, removed $removed non-front clips"
fi

mv "$finalfile" "$filelist"
rm -f "$tmpfile"
